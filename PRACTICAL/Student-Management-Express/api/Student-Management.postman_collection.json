{
  "info": {
    "name": "Student Management Express API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "studentId",
      "value": "REPLACE_WITH_POST_RESPONSE_ID"
    }
  ],
  "item": [
    {
      "name": "API running",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "List students",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/students"
      }
    },
    {
      "name": "Add student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/students",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"K. Pranav\",\n  \"email\": \"pranav@example.com\",\n  \"course\": \"B.Tech CSE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete student",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      }
    }
  ]
}
