PORT=8080
AUTO_OPEN=true
# Optional: force the exact LAN IP used inside QR codes, e.g. 192.168.1.5
PUBLIC_HOST=

# Local mode works immediately and persists state in backend/data/runtime.json.
# Set USE_MYSQL=true after running: npm run db:setup
USE_MYSQL=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dine_db
